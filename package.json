{
  "name": "dsh-dpx",
  "version": "0.1.0",
  "description": "Isolated, discoverable npm environments for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dpx": "bin/dpx.js"
  },
  "files": [
    "assets/windows/",
    "bin/",
    "desktop-shell/",
    "scripts/build-desktop-launcher.ps1",
    "scripts/generate-desktop-sbom.ps1",
    "scripts/publish-desktop-release.ps1",
    "scripts/sign-desktop-manifest.mjs",
    "src/",
    "dsh-distribution.json",
    "README.md",
    "docs/"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs test/*.test.js",
    "check": "npm run test && node --check bin/dpx.js && node --check src/index.js && node --check src/http.js && node --check src/desktop-release.js && node --check src/environment-guide.js",
    "desktop:build": "powershell -ExecutionPolicy Bypass -File scripts/build-desktop-launcher.ps1",
    "desktop:release": "powershell -ExecutionPolicy Bypass -File scripts/build-desktop-launcher.ps1 -OutputDirectory dist",
    "desktop:sbom": "powershell -ExecutionPolicy Bypass -File scripts/generate-desktop-sbom.ps1 -ReleaseDirectory dist",
    "desktop:sign": "node scripts/sign-desktop-manifest.mjs --manifest dist/desktop-latest.json",
    "desktop:verify": "node scripts/sign-desktop-manifest.mjs --verify --manifest dist/desktop-latest.json",
    "desktop:upload": "powershell -ExecutionPolicy Bypass -File scripts/publish-desktop-release.ps1 -Directory dist -Upload",
    "desktop:publish": "powershell -ExecutionPolicy Bypass -File scripts/publish-desktop-release.ps1 -Directory dist -Publish",
    "desktop:verify:window": "powershell -ExecutionPolicy Bypass -File scripts/verify-desktop-shell-window.ps1",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "isolated-environment",
    "npm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/T-Auto/dsh-dpx.git"
  },
  "bugs": {
    "url": "https://github.com/T-Auto/dsh-dpx/issues"
  },
  "homepage": "https://github.com/T-Auto/dsh-dpx#readme"
}
