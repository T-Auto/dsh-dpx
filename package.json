{
  "name": "dsh-dpx",
  "version": "0.1.0",
  "description": "Isolated, discoverable npm environments for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dpx": "bin/dpx.js"
  },
  "files": [
    "bin/",
    "src/",
    "dsh-distribution.json",
    "README.md",
    "docs/"
  ],
  "engines": {
